# n8n Cloudron 2.39.x - Generic OIDC login addon
# Append to /app/data/env.sh

export NODE_OPTIONS="${NODE_OPTIONS:-} --import=/app/data/n8n-oidc-login/bootstrap.mjs"

export N8N_OIDC_ENABLED=true
export N8N_OIDC_N8N_ROOT="/app/code"

# Cloudron provides the public application origin.
export N8N_OIDC_BASE_URL="${CLOUDRON_APP_ORIGIN}"

# Cloudron User Directory -> OpenID external client.
export N8N_OIDC_DISCOVERY_URL="https://my.example.com/.well-known/openid-configuration"
export N8N_OIDC_CLIENT_ID="replace-me"
export N8N_OIDC_CLIENT_SECRET="replace-me"

# Independent addon secret, not the OIDC client secret.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
export N8N_OIDC_COOKIE_SECRET="replace-with-at-least-32-random-characters"

export N8N_OIDC_SCOPES="openid,profile,email"
export N8N_OIDC_REQUIRE_EMAIL_VERIFIED=true
export N8N_OIDC_ALLOW_EMAIL_LINKING=true
export N8N_OIDC_MFA_MODE=idp-amr

# Enable groups only after inspecting the actual claims from your Cloudron IdP.
# export N8N_OIDC_ALLOWED_GROUPS="n8n-users"
# export N8N_OIDC_GROUPS_CLAIM="groups"
